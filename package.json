{
  "name": "loyalty-flip-card",
  "version": "0.1.0",
  "private": true,
  "description": "Home Assistant card that shows a QR code or barcode in a tappable popup",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "jsbarcode": "^3.12.3",
    "lit": "^3.3.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
